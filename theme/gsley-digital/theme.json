				{
					"slug": "body",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": { "min": "1rem", "max": "1.0625rem" }
				},
				{
					"slug": "h3",
					"name": "Heading 3",
					"size": "1.5rem",
					"fluid": { "min": "1.25rem", "max": "1.5rem" }
				},
				{
					"slug": "h2",
					"name": "Heading 2",
					"size": "2.75rem",
					"fluid": { "min": "1.75rem", "max": "2.75rem" }
				},
				{
					"slug": "h1",
					"name": "Heading 1",
					"size": "4.5rem",
					"fluid": { "min": "2.5rem", "max": "4.5rem" }
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "1", "name": "1 · 4px", "size": "0.25rem" },
				{ "slug": "2", "name": "2 · 8px", "size": "0.5rem" },
				{ "slug": "3", "name": "3 · 12px", "size": "0.75rem" },
				{ "slug": "4", "name": "4 · 16px", "size": "1rem" },
				{ "slug": "6", "name": "6 · 24px", "size": "1.5rem" },
				{ "slug": "8", "name": "8 · 32px", "size": "2rem" },
				{ "slug": "12", "name": "12 · 48px", "size": "3rem" },
				{ "slug": "16", "name": "16 · 64px", "size": "4rem" },
				{ "slug": "24", "name": "24 · 96px", "size": "6rem" },
				{ "slug": "32", "name": "32 · 128px", "size": "8rem" }
			]
		},
		"custom": {
			"lineHeight": {
				"tight": "1.1",
				"snug": "1.3",
				"base": "1.55",
				"loose": "1.7"
			},
			"radius": {
				"sm": "6px",
				"md": "10px",
				"lg": "16px",
				"pill": "999px"
			},
			"ease": {
				"out": "cubic-bezier(0.22, 1, 0.36, 1)"
			},
			"duration": {
				"fast": "120ms",
				"base": "240ms",
				"slow": "480ms"
			},
			"container": {
				"narrow": "780px"
			},
			"gutter": "clamp(1rem, 4vw, 2rem)",
			"focus": {
				"color": "#16B8A6",
				"ringWidth": "2px",
				"ringOffset": "2px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink-900)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			},
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink-900)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)", "lineHeight": "1.3" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.3", "fontWeight": "600" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
